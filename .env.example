# Academic data provider credentials
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=

# LLM Provider selection: 'gemini' (default), 'groq', or 'mock'
LLM_PROVIDER=gemini

# Google Gemini settings
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Groq settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Query Planning mode: 'llm' (default) or 'deterministic'
# Set to 'deterministic' (or USE_DETERMINISTIC_PLANNER=true) to generate diverse search queries
# without making an LLM call, saving API quota while retaining LLM research synthesis.
USE_DETERMINISTIC_PLANNER=false
PLANNER_MODE=llm

# Synthesis context limits (reduces LLM token usage per search)
SYNTHESIS_MAX_PAPERS=15
SYNTHESIS_MAX_ABSTRACT_CHARS=1000

